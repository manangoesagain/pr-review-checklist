# Copy this file to a new file called .env (no ".example") and fill in what you want.
# Everything is optional: with no AI key the app runs in basic mode.
# Never share your keys or commit .env: it is already in .gitignore.

# AI reviewer: get a free key at https://build.nvidia.com (it starts with "nvapi-").
NVIDIA_API_KEY=

# Which NVIDIA model reviews the code. Leave it empty for the default. If NVIDIA has
# retired the model, the app finds a working one at startup and tells you its name.
AI_MODEL=

# Optional: a GitHub token raises GitHub's limit from 60 to 5,000 requests an hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# The second AI pass that tries to disprove each AI item. Set to off to compare.
CLAIM_CHECK=on

# The port the app runs on: http://localhost:3000
PORT=3000
